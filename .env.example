# Скопируйте этот файл в .env и задайте СВОЙ надёжный пароль.
# Без .env с ADMIN_PASS docker-compose не соберётся — это осознанная защита:
# пароль по умолчанию считается скомпрометированным.

ADMIN_USER=ta-admin
ADMIN_PASS=замените-на-свой-надёжный-пароль

