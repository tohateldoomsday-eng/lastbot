# Скопируйте этот файл в .env и задайте СВОЙ надёжный пароль.
# Без .env с ADMIN_PASS docker-compose не соберётся — это осознанная защита:
# пароль по умолчанию считается скомпрометированным.

ADMIN_USER=ta-admin
ADMIN_PASS=замените-на-свой-надёжный-пароль

# Telegram-бот для автопостинга новостей в канал (создаётся у @BotFather).
# Пусто = автопостинг отключён. Бот также шлёт уведомления о заявках
# на триал и истекающих акциях.
BOT_TOKEN=
TELEGRAM_CHANNEL=@lastbotdls

# --- Бизнес-логика (опционально, значения по умолчанию ниже) ---

# Бесплатный триал: дней и ботов
TRIAL_DAYS=7
TRIAL_BOTS=5

# Реферальная программа и кэшбэк (проценты)
REFERRAL_COMMISSION_PERCENT=10
CASHBACK_PERCENT=10

# Ориентировочный курс доллара для отображения цен в рублях
RUB_RATE=85
# Секрет подписи JWT-токенов клиентского кабинета (/account).
# Пусто = используется секрет сессии из data/secret.key (безопасно),
# но для продакшена задайте СВОЮ длинную случайную строку.
CLIENT_JWT_SECRET=
